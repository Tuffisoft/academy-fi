generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    OWNER
    INTERN
}

model WeeklyAssignment {
    id                 String                    @id @default(cuid())
    internId           String
    intern             User                      @relation("AssignmentsForIntern", fields: [internId], references: [id])
    weekOf             DateTime
    focus              String
    description        String
    acceptanceCriteria String
    createdById        String
    createdBy          User                      @relation("AssignmentsCreatedBy", fields: [createdById], references: [id])
    createdAt          DateTime                  @default(now())
    updatedAt          DateTime                  @updatedAt
    reflections        Reflection[]
    checklistItems     AssignmentChecklistItem[]
}

model AssignmentChecklistItem {
    id           String           @id @default(cuid())
    assignmentId String
    assignment   WeeklyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
    label        String
    order        Int              @default(0)
    completed    Boolean          @default(false)
    completedAt  DateTime?
    stages       TaskStage[]
}

model TaskStage {
    id              String                  @id @default(cuid())
    checklistItemId String
    checklistItem   AssignmentChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
    title           String
    order           Int                     @default(0)
    completed       Boolean                 @default(false)
    completedAt     DateTime?
    documentation   String?
    createdAt       DateTime                @default(now())
    updatedAt       DateTime                @updatedAt
}

model Reflection {
    id           String           @id @default(cuid())
    assignmentId String
    assignment   WeeklyAssignment @relation(fields: [assignmentId], references: [id])
    internId     String
    intern       User             @relation("ReflectionsForIntern", fields: [internId], references: [id])
    workDone     String
    learning     String
    blocker      String?
    workLink     String?
    nextStep     String
    createdAt    DateTime         @default(now())
    updatedAt    DateTime         @updatedAt
    feedback     MentorFeedback[]
}

model MentorFeedback {
    id           String     @id @default(cuid())
    reflectionId String
    reflection   Reflection @relation(fields: [reflectionId], references: [id])
    authorId     String
    author       User       @relation("FeedbackByAuthor", fields: [authorId], references: [id])
    message      String
    createdAt    DateTime   @default(now())
}

model DiscussionNote {
    id        String   @id @default(cuid())
    userId    String   @unique
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    content   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Department {
    id          String               @id @default(cuid())
    name        String
    nameEN      String
    nameDE      String
    description String?
    order       Int                  @default(0)
    resources   DepartmentResource[]
    createdAt   DateTime             @default(now())
    updatedAt   DateTime             @updatedAt
}

model DepartmentResource {
    id           String     @id @default(cuid())
    departmentId String
    department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
    title        String
    url          String
    note         String?
    order        Int        @default(0)
    createdAt    DateTime   @default(now())
    createdById  String?
    createdBy    User?      @relation("ResourcesAddedBy", fields: [createdById], references: [id], onDelete: SetNull)
    // Set only for uploaded documents; url then points at the hosted file
    fileKey      String?    @unique
    fileName     String?
    fileSize     Int?
}

model Idea {
    id          String     @id @default(cuid())
    title       String
    description String?
    // SetNull keeps ideas and notes when their author's account is deleted
    authorId    String?
    author      User?      @relation("IdeasByAuthor", fields: [authorId], references: [id], onDelete: SetNull)
    notes       IdeaNote[]
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
}

model IdeaNote {
    id        String   @id @default(cuid())
    ideaId    String
    idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
    authorId  String?
    author    User?    @relation("IdeaNotesByAuthor", fields: [authorId], references: [id], onDelete: SetNull)
    content   String
    createdAt DateTime @default(now())
}

model DailyPlan {
    id        String           @id @default(cuid())
    userId    String
    user      User             @relation("DailyPlansByUser", fields: [userId], references: [id], onDelete: Cascade)
    // Calendar day as "YYYY-MM-DD" to avoid timezone shifts
    date      String
    title     String
    stages    DailyPlanStage[]
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt

    @@unique([userId, date])
}

model DailyPlanStage {
    id          String    @id @default(cuid())
    planId      String
    plan        DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
    // Null for top-level stages; set for subsections (one level deep)
    parentId    String?
    parent      DailyPlanStage?  @relation("StageSubsections", fields: [parentId], references: [id], onDelete: Cascade)
    subsections DailyPlanStage[] @relation("StageSubsections")
    title       String
    order       Int       @default(0)
    completed   Boolean   @default(false)
    completedAt DateTime?
}

model User {
    id                  String               @id
    name                String
    email               String
    emailVerified       Boolean              @default(false)
    image               String?
    createdAt           DateTime             @default(now())
    updatedAt           DateTime             @updatedAt
    role                String               @default("INTERN")
    locale              String               @default("en")
    sessions            Session[]
    accounts            Account[]
    assignmentsAsIntern WeeklyAssignment[]   @relation("AssignmentsForIntern")
    assignmentsCreated  WeeklyAssignment[]   @relation("AssignmentsCreatedBy")
    reflections         Reflection[]         @relation("ReflectionsForIntern")
    feedbackAuthored    MentorFeedback[]     @relation("FeedbackByAuthor")
    discussionNote      DiscussionNote?
    resourcesAdded      DepartmentResource[] @relation("ResourcesAddedBy")
    ideas               Idea[]               @relation("IdeasByAuthor")
    ideaNotes           IdeaNote[]           @relation("IdeaNotesByAuthor")
    dailyPlans          DailyPlan[]          @relation("DailyPlansByUser")

    banned     Boolean?  @default(false)
    banReason  String?
    banExpires DateTime?

    @@unique([email])
    @@map("user")
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    impersonatedBy String?

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}
