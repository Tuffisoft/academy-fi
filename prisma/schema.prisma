generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WeeklyAssignment {
  id                 String                    @id @default(cuid())
  internId           String
  weekOf             DateTime
  focus              String
  description        String
  acceptanceCriteria String
  createdById        String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  checklistItems     AssignmentChecklistItem[]
  reflections        Reflection[]
  createdBy          User                      @relation("AssignmentsCreatedBy", fields: [createdById], references: [id])
  intern             User                      @relation("AssignmentsForIntern", fields: [internId], references: [id])
}

model AssignmentChecklistItem {
  id           String           @id @default(cuid())
  assignmentId String
  label        String
  order        Int              @default(0)
  completed    Boolean          @default(false)
  completedAt  DateTime?
  assignment   WeeklyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  stages       TaskStage[]
}

model TaskStage {
  id              String                  @id @default(cuid())
  checklistItemId String
  title           String
  order           Int                     @default(0)
  completed       Boolean                 @default(false)
  completedAt     DateTime?
  documentation   String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  checklistItem   AssignmentChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
}

model Reflection {
  id           String           @id @default(cuid())
  assignmentId String
  internId     String
  workDone     String
  learning     String
  blocker      String?
  workLink     String?
  nextStep     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  feedback     MentorFeedback[]
  assignment   WeeklyAssignment @relation(fields: [assignmentId], references: [id])
  intern       User             @relation("ReflectionsForIntern", fields: [internId], references: [id])
}

model MentorFeedback {
  id           String     @id @default(cuid())
  reflectionId String
  authorId     String
  message      String
  createdAt    DateTime   @default(now())
  author       User       @relation("FeedbackByAuthor", fields: [authorId], references: [id])
  reflection   Reflection @relation(fields: [reflectionId], references: [id])
}

model DiscussionNote {
  id        String   @id @default(cuid())
  userId    String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id          String               @id @default(cuid())
  name        String
  description String?
  order       Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  nameDE      String
  nameEN      String
  resources   DepartmentResource[]
}

model DepartmentResource {
  id           String     @id @default(cuid())
  departmentId String
  title        String
  url          String
  note         String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  createdById  String?
  fileKey      String?    @unique
  fileName     String?
  fileSize     Int?
  createdBy    User?      @relation("ResourcesAddedBy", fields: [createdById], references: [id])
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model Idea {
  id          String     @id @default(cuid())
  title       String
  description String?
  authorId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  author      User?      @relation("IdeasByAuthor", fields: [authorId], references: [id])
  notes       IdeaNote[]
}

model IdeaNote {
  id        String   @id @default(cuid())
  ideaId    String
  authorId  String?
  content   String
  createdAt DateTime @default(now())
  author    User?    @relation("IdeaNotesByAuthor", fields: [authorId], references: [id])
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model DailyPlan {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("DailyPlansByUser", fields: [userId], references: [id], onDelete: Cascade)
  // Calendar day as "YYYY-MM-DD" to avoid timezone shifts
  date      String
  title     String
  stages    DailyPlanStage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, date])
}

model DailyPlanStage {
  id          String           @id @default(cuid())
  planId      String
  plan        DailyPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  // Null for top-level stages; set for subsections (one level deep)
  parentId    String?
  parent      DailyPlanStage?  @relation("StageSubsections", fields: [parentId], references: [id], onDelete: Cascade)
  subsections DailyPlanStage[] @relation("StageSubsections")
  title       String
  order       Int              @default(0)
  completed   Boolean          @default(false)
  completedAt DateTime?
}

model User {
  id                  String               @id
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  role                String               @default("INTERN")
  banned              Boolean?             @default(false)
  banReason           String?
  banExpires          DateTime?
  locale              String               @default("en")
  secureLoginVersion  Int                  @default(0)
  dailyPlans          DailyPlan[]          @relation("DailyPlansByUser")
  resourcesAdded      DepartmentResource[] @relation("ResourcesAddedBy")
  discussionNote      DiscussionNote?
  ideas               Idea[]               @relation("IdeasByAuthor")
  ideaNotes           IdeaNote[]           @relation("IdeaNotesByAuthor")
  feedbackAuthored    MentorFeedback[]     @relation("FeedbackByAuthor")
  reflections         Reflection[]         @relation("ReflectionsForIntern")
  assignmentsCreated  WeeklyAssignment[]   @relation("AssignmentsCreatedBy")
  assignmentsAsIntern WeeklyAssignment[]   @relation("AssignmentsForIntern")
  friendshipsSent     Friendship[]         @relation("FriendshipRequester")
  friendshipsReceived Friendship[]         @relation("FriendshipRecipient")
  directChatsFirst    DirectConversation[] @relation("DirectChatFirstUser")
  directChatsSecond   DirectConversation[] @relation("DirectChatSecondUser")
  chatMemberships     ChatMembership[]
  chatMessages        ChatMessage[]
  groupMemberships    GroupMembership[]
  groupMessages       GroupMessage[]
  chatEncryptionKey   ChatEncryptionKey?
  accounts            Account[]
  sessions            Session[]
  leadSearches        LeadSearch[]
  savedLeads          SavedLead[]
  websiteAudits       WebsiteAudit[]
  pdfReportDesign     PdfReportDesign?
  pdfReportTemplates  PdfReportTemplate[]
  organizationMemberships OrganizationMembership[]
  organizationAuditEntries OrganizationAuditLog[]
  organizationInvitationsCreated OrganizationInvitation[] @relation("InvitationCreator")
  organizationInvitationsAccepted OrganizationInvitation[] @relation("InvitationAcceptor")
  organizationOperations OrganizationOperation[]
  loyaltyOperations LoyaltyOperation[]

  @@map("user")
}

enum LeadSearchStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

model LeadSearch {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  location        String           @db.VarChar(200)
  radiusKm        Float
  industry        String           @db.VarChar(200)
  maxResults      Int
  analyzeWebsites Boolean          @default(true)
  status          LeadSearchStatus @default(DRAFT)
  googlePlaceIds  String[]         @default([])
  savedLeads      SavedLead[]
  runId           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  phase           String?          @db.VarChar(20)
  processedPages  Int              @default(0)
  pauseRequested  Boolean          @default(false)
  checkpoint      Json?
  errorCode       String?          @db.VarChar(40)
  resultLimit     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SavedLead {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId        String      @db.VarChar(512)
  sourceSearchId String?
  sourceSearch   LeadSearch? @relation(fields: [sourceSearchId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@unique([userId, placeId])
  @@index([userId, createdAt])
  @@index([sourceSearchId])
}

model WebsiteAudit {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId      String   @db.VarChar(512)
  status       String   @default("QUEUED") @db.VarChar(20)
  runToken     String
  batchId      String?
  qualityScore Int?
  report       Json?
  errorCode    String?  @db.VarChar(40)
  startedAt    DateTime?
  checkedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, placeId])
  @@index([userId, status])
  @@index([status, startedAt])
  @@index([userId, batchId])
}

model PdfReportDesign {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("Website Insights") @db.VarChar(100)
  source    String   @db.Text
  theme     String   @default("modern") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  templateId String?
  template PdfReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model PdfReportTemplate {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String @db.VarChar(100)
  source    String @db.Text
  theme     String @default("modern") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activeDesigns PdfReportDesign[]

  @@index([userId, updatedAt])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Role {
  OWNER
  INTERN
  CUSTOMER
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETING
}

enum OrganizationRole {
  OWNER
  ADMIN
  STAFF
}

enum OrganizationMembershipStatus {
  ACTIVE
  REVOKED
}

model Organization {
  id           String @id @default(cuid())
  slug         String @unique @db.VarChar(100)
  name         String @db.VarChar(160)
  contactEmail String? @db.VarChar(254)
  status       OrganizationStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  OrganizationMembership[]
  entitlement  OrganizationEntitlement?
  auditEntries OrganizationAuditLog[]
  invitations  OrganizationInvitation[]
  operations   OrganizationOperation[]
  programs     LoyaltyProgram[]
  assets       LoyaltyAsset[]
  loyaltyOperations LoyaltyOperation[]
}

// Draft operations are unique across actors within a tenant. Existing membership history is untouched.
model LoyaltyOperation {
  id String @id @default(cuid())
  organizationId String
  actorId String
  operationId String @db.VarChar(36)
  action String @db.VarChar(40)
  fingerprint String @db.VarChar(64)
  resultId String @db.VarChar(160)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([organizationId, operationId])
  @@index([organizationId, action, createdAt])
}

model LoyaltyAsset {
  id String @id @default(cuid())
  organizationId String
  storageKey String @unique
  mediaType String @default("image/png")
  purpose String @default("LOGO")
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  programs LoyaltyProgram[]
  @@unique([organizationId, id])
}

model LoyaltyProgram {
  id String @id @default(cuid())
  organizationId String
  status String @default("DRAFT") @db.VarChar(20)
  blockedAt DateTime? @db.Timestamp(3)
  conditionsBoundAt DateTime? @db.Timestamp(3)
  name String @db.VarChar(80)
  description String @db.VarChar(500)
  reward String @db.VarChar(160)
  target Int
  backgroundColor String @db.VarChar(7)
  textColor String @db.VarChar(7)
  symbol String @db.VarChar(20)
  logoAssetId String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  logo LoyaltyAsset? @relation(fields: [organizationId, logoAssetId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, id])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, status])
}

model OrganizationInvitation {
  id               String @id @default(cuid())
  organizationId   String
  email            String @db.VarChar(254)
  role             OrganizationRole
  tokenHash        String @unique @db.VarChar(64)
  status           String @default("PENDING") @db.VarChar(20)
  expiresAt        DateTime
  createdById      String
  acceptedById     String?
  acceptedAt       DateTime?
  deliveryAttemptId String
  deliveryStatus   String @default("NOT_SENT") @db.VarChar(24)
  providerId       String? @db.VarChar(160)
  deliveryUpdatedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy        User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedBy       User? @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@index([organizationId, email, createdAt])
}

model OrganizationOperation {
  id             String @id @default(cuid())
  organizationId String
  actorId        String
  operationId    String @db.VarChar(36)
  action         String @db.VarChar(40)
  fingerprint    String @db.VarChar(64)
  resultId       String @db.VarChar(160)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([organizationId, actorId, operationId])
  @@index([organizationId, action, createdAt])
}

model OrganizationMembership {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  status         OrganizationMembershipStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  auditEntries   OrganizationAuditLog[] @relation("AuditMembership")

  @@unique([organizationId, userId])
  @@unique([organizationId, id, userId])
  @@index([userId, status])
}

// This package grants only FREE. Paid entitlements require the later billing package.
model OrganizationEntitlement {
  organizationId String @id
  plan           String @default("FREE") @db.VarChar(20)
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model OrganizationAuditLog {
  id                 String @id @default(cuid())
  organizationId     String
  actorId            String
  actorMembershipId  String?
  action             String @db.VarChar(80)
  targetId           String @db.VarChar(160)
  reason             String @db.VarChar(500)
  createdAt          DateTime @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor              User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorMembership    OrganizationMembership? @relation("AuditMembership", fields: [organizationId, actorMembershipId, actorId], references: [organizationId, id, userId], onDelete: Restrict, map: "OrganizationAuditLog_actor_membership_fkey")

  @@index([organizationId, createdAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model DirectConversation {
  id           String           @id @default(cuid())
  pairKey      String           @unique
  firstUserId  String
  firstUser    User             @relation("DirectChatFirstUser", fields: [firstUserId], references: [id], onDelete: Cascade)
  secondUserId String
  secondUser   User             @relation("DirectChatSecondUser", fields: [secondUserId], references: [id], onDelete: Cascade)
  nextSequence Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  members      ChatMembership[]
  messages     ChatMessage[]
}

model ChatMembership {
  conversationId   String
  conversation     DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenAt         DateTime?
  lastReadSequence Int                @default(0)

  @@id([conversationId, userId])
  @@index([userId, hiddenAt])
}

model ChatMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientId       String
  sequence       Int
  text           String?
  encrypted      Json?
  createdAt      DateTime           @default(now())
  editedAt       DateTime?

  @@unique([conversationId, sequence])
  @@unique([senderId, clientId])
}

model Friendship {
  id          String           @id @default(cuid())
  pairKey     String           @unique
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User             @relation("FriendshipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([requesterId, status])
  @@index([recipientId, status])
}

model ChatEncryptionKey {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    Int
  publicKey  String
  salt       String
  nonce      String
  ciphertext String
  createdAt  DateTime @default(now())
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum GroupMemberStatus {
  INVITED
  ACTIVE
}

model GroupConversation {
  id           String            @id
  name         String
  nextSequence Int               @default(0)
  archivedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  members      GroupMembership[]
  messages     GroupMessage[]
}

model GroupMembership {
  conversationId   String
  conversation     GroupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             GroupRole         @default(MEMBER)
  status           GroupMemberStatus @default(INVITED)
  joinedSequence   Int               @default(0)
  lastReadSequence Int               @default(0)
  joinedAt         DateTime          @default(now())

  @@id([conversationId, userId])
  @@index([userId, status])
}

model GroupMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   GroupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  clientId       String
  sequence       Int
  encrypted      Json
  createdAt      DateTime          @default(now())
  editedAt       DateTime?

  @@unique([conversationId, sequence])
  @@unique([senderId, clientId])
}
